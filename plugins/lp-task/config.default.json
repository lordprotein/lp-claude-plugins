{
  "tracker": {
    "type": "jira",
    "issueUrl": "",
    "keyRegex": "([A-Z][A-Z0-9]+)-(\\d+)",
    "titleStripPrefixes": []
  },
  "git": {
    "host": "gitlab",
    "branch": "{key}",
    "commit": "{key}: {title}",
    "fixCommit": "{key}: fix ({summary})",
    "mrTitle": "{key}: {title}",
    "mrDescription": ["{issueUrl}", "", "{title}", "", "{commits}"],
    "ignorePaths": []
  },
  "mrMessage": {
    "header": "",
    "lines": ["{header}", "{mrTitle}", "", "{links}"],
    "link": "* {label}: {url}",
    "clipboard": false
  },
  "howToTest": {
    "header": "",
    "maxCases": 6,
    "environment": "",
    "clipboard": false
  },
  "isAllowHowToTestAfterPush": false,
  "stateDir": "~/.claude/lp-task/state",
  "review": {
    "postToMr": "ask",
    "minSeverity": "medium",
    "gitlab": {
      "mcpServer": "gitlab"
    }
  },
  "projects": [],
  "planNotes": [],
  "pushNotes": [],
  "browserTest": {
    "forbiddenActions": [
      "real payments and any other money actions",
      "typing credentials",
      "irreversible account actions (deletion, settings changes)"
    ],
    "mobileViewport": "390x844"
  }
}
