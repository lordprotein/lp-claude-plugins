{
  "tracker": {
    "type": "jira",
    "issueUrl": "https://example.atlassian.net/browse/{key}",
    "keyRegex": "(ACME)-(\\d+)",
    "titleStripPrefixes": ["[FE]", "[Front]"]
  },
  "git": {
    "host": "gitlab",
    "branch": "ACME-{num}",
    "commit": "{key}: {title}",
    "fixCommit": "{key}: fix ({summary})",
    "mrTitle": "{key}: {title}",
    "mrDescription": ["{issueUrl}", "", "{title}", "", "{commits}"],
    "ignorePaths": [".yalc/", "yalc.lock"]
  },
  "mrMessage": {
    "header": "@acme-team",
    "lines": ["{header} {mrTitle}", "{issueUrl}", "", "{links}"],
    "link": "- {label} → {url}",
    "clipboard": true
  },
  "stateDir": "~/.claude/lp-task/state",
  "review": {
    "postToMr": "ask",
    "minSeverity": "medium",
    "gitlab": { "mcpServer": "gitlab" }
  },
  "projects": [
    {
      "id": "web",
      "label": "Web",
      "path": "acme-web",
      "pm": "yarn",
      "lint": "npx eslint",
      "dev": "yarn dev"
    },
    {
      "id": "mobile-web",
      "label": "Mobile web",
      "path": "acme-mobile-web",
      "pm": "yarn",
      "mobile": true
    },
    {
      "id": "ui-kit",
      "label": "UI kit",
      "path": "acme-ui-kit",
      "pm": "pnpm",
      "autoDetectOnly": true,
      "notes": [
        "Included when the task touches components imported from @acme/ui-kit",
        "Add a changeset (pnpm changeset)"
      ]
    }
  ],
  "planNotes": [
    "Compare the same places in web and mobile-web: the folder structure differs (pages vs screens)"
  ],
  "pushNotes": [
    "If the task changes ui-kit, split the MRs into two groups: `kit` (only ui-kit) and `apps` (the other task projects); otherwise one group",
    "Push `kit` first. Push `apps` only when the published @acme/ui-kit version with the task changes is set in the package.json of every app of the task; until then the apps wait"
  ],
  "browserTest": {
    "forbiddenActions": ["checkout and payments", "typing credentials"],
    "mobileViewport": "390x844"
  }
}
